{
  "opencollection": "1.0.0",
  "info": {
    "name": "PostNL Shipment API",
    "version": "v4"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "apikey",
      "value": "{{apikey}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "CreateShipment",
        "type": "http"
      },
      "http": {
        "method": "POST",
