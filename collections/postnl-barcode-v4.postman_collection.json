  "info": {
    "_postman_id": "1315e073-4cc6-4ba2-9e6e-d22ca68930f3",
    "name": "PostNL Barcode API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": " The PostNL Barcode API is a RESTful API that generates 3S-barcodes for domestic and European parcel flows. Additional barcode domestic types may be added in future versions. Barcodes for non-european and mailpackets are generated automatically during Shipment v4 creation and cannot not be requested via this endpoint.\n\nContact Support:\n Name: PostNL",
      "type": "text/plain"
    }
  }
