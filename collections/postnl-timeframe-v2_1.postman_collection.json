        {
          "id": "33f8bca7-6d1a-471c-8146-20b477ecee92",
          "name": "Retrieve expected delivery timeframes",
          "request": {
            "name": "Retrieve expected delivery timeframes",
            "description": {
              "content": "Request example:\n```\ncurl -X GET \"https://api-sandbox.postnl.nl/shipment/v2_1/calculate/timeframes?AllowSundaySorting=false&StartDate=30-06-2022&EndDate=02-07-2022&CountryCode=NL&PostalCode=2132WT&HouseNumber=42&HouseNrExt=A&City=Hoofddorp&Street=Siriusdreef&Options=Daytime%2CEvening\" \\\n -H \"Accept: application/json\" \\\n -H \"apikey: APIKEY-HERE\" \\\n```\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "shipment",
                "v2_1",
                "calculate",
                "timeframes"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "AllowSundaySorting",
                  "value": "<boolean>",
                  "description": "(Required) Whether or not the requesting party allows for Sunday sorting (which leads to delivery on Monday)."
                },
                {
                  "disabled": false,
                  "key": "StartDate",
                  "value": "<string>",
                  "description": "(Required) Date of the beginning of the timeframe. Format: dd-MM-yyyy"
                },
                {
                  "disabled": false,
                  "key": "EndDate",
                  "value": "<string>",
                  "description": "(Required) Date of the enddate of the timeframe. Format:dd-MM-yyyy. Enddate may not be before StartDate."
                },
                {
                  "disabled": false,
                  "key": "CountryCode",
                  "value": "<string>",
                  "description": "(Required) The ISO2 country code of the delivery address"
                },
                {
                  "disabled": false,
                  "key": "PostalCode",
                  "value": "<string>",
                  "description": "(Required) Zipcode of the delivery address"
                },
                {
                  "disabled": false,
                  "key": "HouseNumber",
                  "value": "<integer>",
                  "description": "(Required) The house number of the delivery address"
                },
                {
                  "disabled": false,
                  "key": "HouseNrExt",
                  "value": "<string>",
                  "description": "House number extension of the delivery address"
                },
                {
                  "disabled": false,
                  "key": "City",
                  "value": "<string>",
                  "description": "City of the delivery address"
                },
                {
                  "disabled": false,
                  "key": "Street",
                  "value": "<string>",
                  "description": "The street name of the delivery address"
                },
                {
                  "disabled": false,
                  "key": "Options",
                  "value": "<string>,<string>",
                  "description": "(Required) The delivery options for which expected timeframes should be calculated. At least one delivery option must be specified. Multiple values should be comma-separated."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "apikey"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            }
          },
