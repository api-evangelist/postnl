              "body": "{\n  \"Timeframes\": {\n    \"Timeframe\": [\n      {\n        \"Date\": \"02-07-2022\",\n        \"Timeframes\": {\n          \"TimeframeTimeframe\": [\n            {\n              \"From\": \"12:30:00\",\n              \"Options\": {\n                \"string\": \"Daytime\"\n              },\n              \"To\": \"14:30:00\",\n              \"Sustainability\": {\n                \"Code\": \"02\",\n                \"Description\": \"Sustainable option\"\n              }\n            }\n          ]\n        }\n      }\n    ]\n  },\n  \"ReasonNoTimeframes\": {\n    \"ReasonNoTimeframe\": [\n      {\n        \"Code\": \"1\",\n        \"Date\": \"02-07-2022\",\n        \"Description\": \"Delivery date not allowed\",\n        \"Options\": {\n          \"string\": \"Evening\"\n        },\n        \"Sustainability\": {\n          \"Code\": \"02\",\n          \"Description\": \"Sustainable option\"\n        }\n      }\n    ]\n  }\n}",
